# Copier en .env et ajuster (le .env n'est jamais commité).

POSTGRES_USER=clubjudge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=clubjudge

# Backend lancé sur l'hôte en dév :
DATABASE_URL=postgresql+psycopg://clubjudge:change-me@localhost:5433/clubjudge
JUDGE0_URL=http://localhost:2358

# Profil Docker `full` / production derrière TLS.
SECURE_COOKIES=true
DISCORD_WEBHOOK_URL=
SUBMISSION_COOLDOWN_S=10

# Bornes de ressources des conteneurs (à adapter à la machine du club).
BACKEND_PIDS_LIMIT=256
BACKEND_MEMORY_LIMIT=2g
BACKEND_CPUS=2.0
JUDGE0_PIDS_LIMIT=512
JUDGE0_CONTAINER_MEMORY=2g
JUDGE0_CPUS=2.0
